<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".AboutActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".DiagnosticsActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".HistorySyncActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".HistoryStatisticsActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".MeterDetailsActivity" android:exported="false" android:screenOrientation="unspecified" />

        <activity android:name=".ProductDashboardActivity" android:exported="true" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
